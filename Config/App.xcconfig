PRODUCT_NAME = TaiKueriRunner
PRODUCT_BUNDLE_IDENTIFIER = dev.taisan11.TaiKueriRunner
// Simple Apple ID sideloading only. Building never needs a team or account.
CODE_SIGNING_ALLOWED = NO
CODE_SIGN_ENTITLEMENTS = TaiKueriRunner/TaiKueriRunner.entitlements
INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = NO
SWIFT_OBJC_BRIDGING_HEADER = TaiKueriRunner/Native/Bridging-Header.h
SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos
SUPPORTS_MACCATALYST = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
OTHER_LDFLAGS = $(inherited) -lsqlite3 -lz
